{
  "name": "zalo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Zalo group bot: lưu toàn bộ tin nhắn nhóm, trả lời khi được tag bằng agent trên OpenWebUI",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:listener": "ROLE=listener node src/index.js",
    "start:worker": "ROLE=worker node src/index.js",
    "migrate": "node scripts/migrate.js",
    "probe:openwebui": "node scripts/probe-openwebui.js",
    "test": "node --test --test-force-exit test/unit.test.js test/connection.test.js",
    "test:e2e": "E2E=1 node --test --test-force-exit test/e2e.test.js"
  },
  "dependencies": {
    "bullmq": "5.34.10",
    "dotenv": "16.4.7",
    "ioredis": "5.4.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "ws": "8.23.0",
    "zca-js": "2.3.0"
  },
  "devDependencies": {
    "pino-pretty": "13.0.0"
  }
}
