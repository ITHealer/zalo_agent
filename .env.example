# Sao chép thành .env rồi điền giá trị:  cp .env.example .env
# File này dùng chung cho cả zalo-gateway (Node) và agent-service (Python).

# ===================== BẮT BUỘC =====================
# Agent trên OpenWebUI
OPENWEBUI_URL=https://openwebui.your-company.vn
OPENWEBUI_API_KEY=sk-xxxxxxxx
# Model ID của agent (Workspace > Models), KHÔNG phải tên hiển thị. Có thể dùng OPENWEBUI_MODEL_ID.
OPENWEBUI_MODEL=your-agent-id

# Mật khẩu cho database Postgres MỚI do docker compose tạo (tự đặt, đặt trước lần chạy đầu tiên)
#   Tạo nhanh:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Token bảo vệ API quản trị + trang QR của agent-service (tự đặt, chuỗi dài ngẫu nhiên)
#   Tạo nhanh:  openssl rand -hex 24
ADMIN_API_TOKEN=

# ===================== NÊN CẤU HÌNH =====================
# Chỉ trả lời trong các nhóm này (group id, phân cách dấu phẩy). Trống = mọi nhóm bot tham gia.
# Lấy group id:  GET /api/threads
REPLY_GROUP_ALLOWLIST=
# Webhook nhận cảnh báo (cần quét QR, mất kết nối, trả lời lỗi). Slack/Google Chat/Teams đều dùng được.
ALERT_WEBHOOK_URL=

# ===================== TUỲ CHỌN (đã có mặc định hợp lý) =====================
# --- agent-service: gọi OpenWebUI ---
# chat = chạy tool phía server (khuyến nghị) | completions = OpenAI-compatible đơn giản (agent không có tool)
OPENWEBUI_MODE=chat
# true = bật builtin tools, cần khi agent tra Knowledge Base (function calling native)
OPENWEBUI_ENABLE_BUILTIN_TOOLS=true
# Trống = tự lấy tool đang gắn trên agent. "none" = không dùng tool.
OPENWEBUI_TOOL_IDS=
OPENWEBUI_TIMEOUT_SECONDS=180
OPENWEBUI_ROTATE_CHAT_DAILY=true
OPENWEBUI_HISTORY_TURNS=4

# --- agent-service: soạn câu trả lời ---
REPLY_CONTEXT_MESSAGES=30
REPLY_CHUNK_SIZE=1800
REPLY_MENTION_SENDER=true
REPLY_MAX_ATTEMPTS=4
# Câu gửi khi không trả lời được sau nhiều lần thử (trống = im lặng)
REPLY_FALLBACK_TEXT=
WORKER_CONCURRENCY=3

# --- zalo-gateway: khi nào bot trả lời ---
REPLY_ON_QUOTE_TO_BOT=true
REPLY_ON_MENTION_ALL=false
TRIGGER_KEYWORDS=
REPLY_TO_DIRECT_MESSAGES=false
# Tag cũ hơn ngưỡng này (vd bắt được khi bù tin sau sự cố dài) sẽ không được trả lời
REPLY_MAX_AGE_MS=3600000

# --- zalo-gateway: lưu tin ---
STORE_DIRECT_MESSAGES=true
STORE_GROUP_ALLOWLIST=

# --- zalo-gateway: gửi tin ---
REPLY_DELAY_MIN_MS=1500
REPLY_DELAY_MAX_MS=4000
SEND_MIN_INTERVAL_MS=1000

# --- zalo-gateway: độ ổn định kết nối ---
SWEEP_INTERVAL_MS=300000
WS_PING_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=15000
IDLE_RECONNECT_MS=900000
DUPLICATE_CONNECTION_BACKOFF_MS=120000

LOG_LEVEL=info
ZALO_ACCOUNT_KEY=default
