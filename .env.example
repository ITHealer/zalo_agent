# ================== BẮT BUỘC ==================
# Agent trên OpenWebUI
OPENWEBUI_URL=https://openwebui.your-company.vn
# Settings > Account > API Keys (tài khoản này phải có quyền dùng agent + các tool của agent)
OPENWEBUI_API_KEY=sk-xxxxxxxx
# ID của agent (Workspace > Models > mở agent, xem phần "Model ID"), KHÔNG phải tên hiển thị
OPENWEBUI_MODEL=your-agent-id

# Mật khẩu Postgres khi chạy bằng docker compose
POSTGRES_PASSWORD=doi-mat-khau-nay

# ================== NÊN CẤU HÌNH ==================
# Chỉ trả lời trong các nhóm này (group id, phân cách dấu phẩy). Trống = mọi nhóm bot tham gia.
# Lấy group id: xem bảng zalo_threads sau khi bot chạy vài phút.
REPLY_GROUP_ALLOWLIST=
# Webhook nhận cảnh báo (mất kết nối, cần quét QR, trả lời lỗi). Nhận JSON {"text": "..."}
# (Slack/Google Chat/Teams incoming webhook đều dùng được)
ALERT_WEBHOOK_URL=

# ================== TUỲ CHỌN (đã có mặc định hợp lý) ==================
# chat = chạy tool phía server (khuyến nghị) | completions = OpenAI-compatible đơn giản (agent không có tool)
OPENWEBUI_MODE=chat
# true = bật builtin tools, cần khi agent tra Knowledge Base (function calling native)
OPENWEBUI_ENABLE_BUILTIN_TOOLS=true
# Trống = tự lấy tool đang gắn trên agent. "none" = không dùng tool.
OPENWEBUI_TOOL_IDS=
OPENWEBUI_TIMEOUT_MS=180000

# Kích hoạt bot: @tag luôn bật. Thêm các cách khác:
REPLY_ON_QUOTE_TO_BOT=true
REPLY_ON_MENTION_ALL=false
TRIGGER_KEYWORDS=
REPLY_TO_DIRECT_MESSAGES=false
STORE_DIRECT_MESSAGES=true
STORE_GROUP_ALLOWLIST=

# Hành vi trả lời
REPLY_MENTION_SENDER=true
REPLY_DELAY_MIN_MS=1500
REPLY_DELAY_MAX_MS=4000
REPLY_RATE_MAX=20
REPLY_RATE_DURATION_MS=60000
CONTEXT_MESSAGES=30
REPLY_FALLBACK_TEXT=
# Tag cũ hơn ngưỡng này (vd bắt được khi bù tin sau sự cố dài) sẽ không trả lời
REPLY_MAX_AGE_MS=3600000

# Độ ổn định kết nối
SWEEP_INTERVAL_MS=300000
WS_PING_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=15000
IDLE_RECONNECT_MS=900000
DUPLICATE_CONNECTION_BACKOFF_MS=120000

# Khác
LOG_LEVEL=info
ROLE=all
ZALO_ACCOUNT_KEY=default
